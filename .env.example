NODE_ENV=development
APP_VERSION=0.1.0
# Production defaults to https://ravelyth.in. Set to your local origin for development.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (required for accounts, sessions, and saved analyses)
# Public DNS/email tools work without it; account features return a clear
# "temporarily unavailable" error until PostgreSQL is configured.
# NEVER commit real credentials. Server-side only — never exposed to the browser.
# Example (local development):
# DATABASE_URL=postgresql://ravelyth:ravelyth@localhost:5432/ravelyth
DATABASE_URL=

# Trust X-Forwarded-For / X-Real-IP for rate-limit keys. Enable ONLY when the
# app runs behind a reverse proxy that sets these headers (nginx in production).
# When false, requests share a single rate-limit bucket instead of trusting a
# client-controlled header. Defaults to true when NODE_ENV=production.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# No session secret is required: session tokens are opaque 256-bit random
# values; only a SHA-256 hash is stored server-side. If a future feature needs
# a secret, generate one with: openssl rand -base64 32

# DNS
DNS_TIMEOUT_MS=10000
DNS_QUERY_TIMEOUT_MS=8000
MAX_DNS_QUERIES_PER_REQUEST=32
MAX_SPF_INCLUDE_LOOKUPS=10

# ---------------------------------------------------------------------------
# Outbound web/TLS diagnostics (SSL checker, HTTP header checkers, website
# availability, RDAP domain information).
# HTTP_REQUEST_TIMEOUT_MS is a TOTAL budget per request including redirects.
# Ports other than 80/443 are refused, and every resolved address must be
# public unicast before a connection is attempted (SSRF protection).
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=65536
HTTP_MAX_REDIRECTS=3
HTTP_MAX_ADDRESS_ATTEMPTS=3
# ---------------------------------------------------------------------------
# Part 2 — Public support/request surfaces (PART 3 may add a private operator
# tier later). Until then, the public-facing routes are the only ones
# configured to render in the help center.
# NOTE: these four variables are NOT read by the current application code.
# They are reserved for future help-center/partner tier work. Verify usage in
# src/lib/config/index.ts before relying on them.
ENABLE_PUBLIC_HELP_CENTER_TIER=1
PARTNER_ACTIVE_TIER=0
PARTNER_PRIVATE_ONLY=0

# In Part 2, "public" partner/help contacts are exposed only when there is at
# least one configured, publicly visible account tier. If this is disabled,
# partner/public-facing helpers are hidden even when rows exist.
PUBLIC_FACING_HELPER_TIER_ENABLED=1

TLS_CONNECT_TIMEOUT_MS=10000
RDAP_TIMEOUT_MS=10000

# DNS propagation / resolver comparison: maximum number of public resolvers
# queried per request (each counts against MAX_DNS_QUERIES_PER_REQUEST).
MAX_PROPAGATION_RESOLVERS=6

# Optional public contact address shown on /contact when configured.
# Leave empty to show the documented channels only (no placeholder address).
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Pricing pages (Part 1). In development and part-1, billing is never a live
# integration; USE_DEMO_BILLING is set automatically based on NODE_ENV.
# Setting this explicitly to "false" in a test/staging environment opts in to
# the live-flow stubs.
# USE_DEMO_BILLING=true

# ---------------------------------------------------------------------------
# Part 2 — Managed Support plan, billing foundation and support limits.
# The Managed Support price is configured here and ONLY here (integer minor
# units: 59900 paise = ₹599.00 per month). Amounts are never floats.
MANAGED_SUPPORT_PRICE_MINOR=59900
MANAGED_SUPPORT_CURRENCY=INR
MANAGED_SUPPORT_BILLING_INTERVAL=monthly
# Quarterly/yearly prices are unresolved commercial decisions: leave unset to
# keep them explicitly "not offered" (they are never invented automatically).
# MANAGED_SUPPORT_QUARTERLY_PRICE_MINOR=
# MANAGED_SUPPORT_YEARLY_PRICE_MINOR=
# Payment gateway. Leave EMPTY while no provider is connected: the application
# then never reports a successful payment and shows "billing integration
# pending" everywhere instead of a checkout that cannot complete.
BILLING_PROVIDER=
# Razorpay credentials (only used when BILLING_PROVIDER=razorpay). Checkout is
# refused until ALL THREE are present: the order API needs the key credentials,
# payment confirmations are verified with the KEY SECRET, and webhook events are
# signed with the WEBHOOK SECRET. Never commit real credentials.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Grace period after a failed payment. 0 = not decided (commercial decision).
BILLING_GRACE_PERIOD_DAYS=0

# Support limits.
# SUPPORT_MAX_OPEN_TICKETS: open-ticket limit included in Managed Support.
# All customer-facing support is paid Managed Support; there is no public flow.
SUPPORT_MAX_OPEN_TICKETS=5
# Per-account ticket creation throttle.
SUPPORT_TICKET_RATE_LIMIT_MAX=10
SUPPORT_TICKET_RATE_LIMIT_WINDOW_MS=900000
# Include support-agent replies on customer-facing ticket views. Defaults to
# false: internal agent notes stay internal.
SUPPORT_INCLUDE_INTERNAL_RESPONSES=false

# Part 3 — Control/Agent/licensing foundation (see src/lib/control docs).
CONTROL_LICENSE_KEY_PREFIX=RVLY-LIC
CONTROL_ACTIVATION_TTL_DAYS=365
CONTROL_SERVER_TOKEN_PREFIX=rvly-srv
CONTROL_AGENT_NONCE_TTL_MS=300000
CONTROL_AGENT_NONCE_MAX_PER_SERVER=100
CONTROL_AGENT_NONCE_CLEANUP_INTERVAL_MS=3600000
# When true, control servers are isolated per provider/tenant (safe default).
CONTROL_PROVIDER_TENANT_ISOLATION=true

# Part 4 — internal operations.
# Owner bootstrap email: the ONLY account auto-promoted to the owner role at
# sign-in. Leave empty in shared environments; never a client-configurable value.
OWNER_EMAIL=
OWNER_IMPERSONATION_TTL_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=365

# Monetization (ads render only when explicitly enabled AND CSP-compatible).
ADSENSE_CLIENT_ID=
# Transactional email. Leave EMPTY until a provider is configured: the
# application then never claims an email was delivered.
EMAIL_PROVIDER=
EMAIL_FROM=
# Invoice numbering prefix used by internal billing operations.
INVOICE_NUMBER_PREFIX=RVLY

# Request limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_EMAIL_HEADER_BYTES=262144
MAX_INDIVIDUAL_HEADER_BYTES=16000
MAX_HEADER_COUNT=150
MAX_LINE_LENGTH=998

# Rate limiting (in-memory; replace with Redis for multi-instance production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ---------------------------------------------------------------------------
# Part 6 — Ravelyth Talent (recruitment vertical).
# Private directory for candidate documents. Must be OUTSIDE /public and is
# never committed. Defaults beside the application when unset.
TALENT_STORAGE_DIR=.ravelyth-private/talent-documents
TALENT_MAX_RESUME_BYTES=5242880
# Public application submissions are unauthenticated, so they are throttled per
# client identity (see TRUST_PROXY_HEADERS above).
TALENT_APPLICATION_RATE_LIMIT_MAX=5
TALENT_APPLICATION_RATE_LIMIT_WINDOW_MS=3600000
# Maximum simultaneously open applications allowed per candidate email.
TALENT_MAX_OPEN_APPLICATIONS_PER_CANDIDATE=10

# ---------------------------------------------------------------------------
# RAVELYTH TALENT - PROFESSIONAL JOB PORTAL
# ---------------------------------------------------------------------------
# Every value below is a SAFE PLACEHOLDER. Never commit a real credential.
# The portal works without any of these; unset values simply mean the related
# capability is not configured, and the application reports that honestly
# instead of pretending an email was sent or a payment succeeded.

# Public origin of the deployed portal. Used to build verification and
# password-reset links server-side. MUST be set in production; the default
# localhost value must never reach production.
# APP_URL=http://localhost:3000

# Job posting workflow.
# When true (the safe default) an employer cannot publish a job directly: the
# posting must be approved by an admin first. Server-enforced, not a UI setting.
JOB_APPROVAL_REQUIRED=true
# Default lifetime of a published posting, in days.
JOB_DEFAULT_VALIDITY_DAYS=60
# Require a verified email before a candidate can apply to a job.
JOB_REQUIRE_VERIFIED_EMAIL_TO_APPLY=true
# Require purchased job credits before a job can be submitted for approval.
JOB_CREDIT_REQUIRED=true

# Private storage for resumes, avatars and company logos.
# Must be OUTSIDE /public and must never be committed. Defaults to a sibling
# directory of the application. Swap the storage driver for object storage
# (S3/R2) before a multi-node production deployment; the local driver is not
# production-safe on its own.
# PORTAL_STORAGE_DIR=.ravelyth-private/portal
# Upload limits, in bytes.
PORTAL_MAX_RESUME_BYTES=5242880
PORTAL_MAX_IMAGE_BYTES=2097152
# Accepted image types for avatars and company logos.
PORTAL_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp

# Email verification rate limits (per client identity).
EMAIL_VERIFICATION_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_VERIFICATION_RESEND_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_RESEND_RATE_LIMIT_WINDOW_MS=3600000

# Transactional email (SMTP).
# Set EMAIL_PROVIDER=smtp AND supply SMTP_HOST/EMAIL_FROM to enable delivery.
# While unset, verification and password-reset emails are never claimed as
# sent, and the affected flow degrades safely.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Require STARTTLS on non-secure ports (recommended; 465 implies TLS).
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Ravelyth Talent reuses the existing provider abstraction. Checkout is refused
# until ALL THREE Razorpay credentials are present, and browser-side payment
# success is never trusted: status is confirmed by a server-verified signature
# and by a signed webhook, both processed idempotently.
# BILLING_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Webhook route that receives gateway events (record this exact URL in the
# gateway dashboard before going live).
# PAYMENT_WEBHOOK_PATH=/api/portal/payments/webhook

# ---------------------------------------------------------------------------
# Ravelyth Talent social profiles (OPTIONAL).
#
# Every value is optional and empty by default. Set only the channels that
# genuinely exist, using the full https URL of the official profile.
#
# A channel that is unset, blank, non-https, or pointing at the wrong domain is
# NOT rendered in the footer at all. That is deliberate: the site will never
# guess an account or link to a profile that may not exist, so a deployment that
# has not finished this list simply shows fewer links.
#
# Allowed hosts per channel (enforced in src/lib/social.ts):
#   SOCIAL_X         -> https://x.com/...        (twitter.com also accepted)
#   SOCIAL_LINKEDIN  -> https://www.linkedin.com/company/...
#   SOCIAL_GITHUB    -> https://github.com/...
#   SOCIAL_YOUTUBE   -> https://www.youtube.com/...
#   SOCIAL_INSTAGRAM -> https://www.instagram.com/...
#   SOCIAL_FACEBOOK  -> https://www.facebook.com/...
#
# SOCIAL_X=
# SOCIAL_LINKEDIN=
# SOCIAL_GITHUB=
# SOCIAL_YOUTUBE=
# SOCIAL_INSTAGRAM=
# SOCIAL_FACEBOOK=

# ---------------------------------------------------------------------------
# Private admin console (Ravelyth Talent)
# ---------------------------------------------------------------------------
# The administrator signs in with a USERNAME at /api/portal/admin/login, not an
# email address, so the console's existence is not tied to a discoverable
# mailbox. Ordinary candidate and employer accounts have no username and cannot
# sign in through that endpoint at all.
#
# The credential NEVER lives in source. Supply exactly ONE of:
#   ADMIN_PASSWORD_HASH - an Argon2id hash (preferred; the plaintext never
#                         exists anywhere, not even in the deployment env)
#   ADMIN_PASSWORD      - a plaintext password, hashed once at bootstrap.
#                         Convenient, but the secret then sits in the env store.
#
# Leave BOTH empty to disable bootstrap entirely and manage administrator
# accounts manually in the database. With neither set, ADMIN_BOOTSTRAP_ENABLED
# is false and no admin account is created or reconciled.
#
# Generate a hash with:
#   node -e "require('@node-rs/argon2').hash('your-password').then(console.log)"
# ADMIN_USERNAME=Liky
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Recruiter plans, job-post limits and portal billing
# ---------------------------------------------------------------------------
# When true (the default) the monthly job-post allowance that comes with a
# recruiter plan is ENFORCED server-side: a submission that would exceed the
# allowance is refused with 402 PLAN_LIMIT_REACHED. Set false only to make the
# allowance advisory.
RECRUITER_JOB_LIMIT_ENFORCED=true
# When true, a company with NO active recruiter plan cannot post at all. Left
# false by default so a company holding prepaid job credits can still post.
RECRUITER_REQUIRE_ACTIVE_PLAN=false
# Fraction of the allowance at which the UI warns (0.8 = 80% used).
RECRUITER_LIMIT_WARNING_RATIO=0.8
# How many days before renewal the subscription is flagged "expiring".
RECRUITER_RENEWAL_WARNING_DAYS=7

# Tax applied to portal invoices, in basis points. 1800 = 18% GST.
# The default is 0, which issues invoices with NO tax line. Set this explicitly
# before taking real payments: an Indian taxable supply is 18% GST.
BILLING_TAX_RATE_BASIS_POINTS=0
# Invoice number prefix. Numbers are year-scoped: RVLYT-2026-000001.
PORTAL_INVOICE_NUMBER_PREFIX=RVLYT
# Billing entity printed on an invoice. Supply the registered address and GSTIN
# for a document that is valid for GST purposes; leaving them blank prints an
# invoice without them rather than inventing them.
BILLING_ENTITY_NAME=Ravelyth Talent
# BILLING_ENTITY_EMAIL=billing@ravelyth.in
# BILLING_ENTITY_ADDRESS=
# BILLING_ENTITY_GSTIN=
