# =============================================================================
# Ravelyth Talent - environment variables
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://ravelyth_app:CHANGE_ME@127.0.0.1:5432/ravelyth

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
CRON_SECRET=

# --- Admin bootstrap (npm run seed:admin) ------------------------------------
ADMIN_NAME=Liky
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Local file storage (resumes, resumes PDFs, invoices, logos) -------------
# Must live OUTSIDE /public. Absolute path on the server.
UPLOAD_DIR=./uploads

# --- SMTP (nodemailer) -------------------------------------------------------
SMTP_HOST=mail.ravelyth.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ravelyth Talent <noreply@ravelyth.in>"
# Address that receives Contact / support form submissions (optional;
# falls back to site_settings.contact_email)
SUPPORT_EMAIL=

# --- Assistant inbox and optional AI -----------------------------------------
# Inbox credentials are only read by the server and are never stored in the DB.
INBOX_SUPPORT_USER=
INBOX_SUPPORT_PASS=
INBOX_SUPPORT_ADDRESS=
INBOX_GMAIL_USER=
INBOX_GMAIL_APP_PASSWORD=
# Optional; AI remains disabled unless separately enabled in admin settings.
ANTHROPIC_API_KEY=

# --- Social auto-posting (Task 9) -------------------------------------------
# Meta Graph API credentials for Ravelyth's own Facebook Page and linked
# Instagram professional account. Leave empty to show "Not configured".
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_FACEBOOK_PAGE_TOKEN=
SOCIAL_INSTAGRAM_USER_ID=
# Graph API version used in request URLs (e.g. v26.0). Verify against Meta's
# current docs before relying on it; see KNOWN_ISSUES.md.
SOCIAL_GRAPH_VERSION=v26.0

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Google OAuth (2.0, PKCE) ------------------------------------------------
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS provider ------------------------------------------------------------
# console | msg91 | twilio  (console only logs the OTP; never use in prod)
# OTP request/verify endpoints stay hidden (HTTP 503) until SMS_PROVIDER is
# msg91 or twilio and every variable for that provider is filled in.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Off-site backups (deploy/scripts/offsite-backup.sh) ---------------------
# One-time setup guide: deploy/OFFSITE_BACKUP.md. Provider credentials live
# only in rclone's own config file on the server - never here, never in git.
# The off-site systemd timer ships disabled; nothing runs until you enable it.
# Remote name plus bucket/folder, e.g. OFFSITE_RCLONE_REMOTE=offsite:my-bucket
OFFSITE_RCLONE_REMOTE=
# Sub-folder inside that remote, e.g. ravelyth/backups
OFFSITE_RCLONE_PATH=
# Optional: absolute path to a passphrase file for gpg symmetric encryption
# of the off-site copies (create it mode 600, owned by the ravelyth user)
OFFSITE_GPG_PASSPHRASE_FILE=
# Optional: days to keep copies on the remote before pruning (default 30)
OFFSITE_RETENTION_DAYS=30

# --- Feature flags -----------------------------------------------------------
# Blog, reviews, salary insights, and resume database flags are managed in
# site_settings from /admin/settings.
