[Unit]
Description=Back up the Ravelyth Talent PostgreSQL database
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=ravelyth
Group=ravelyth
Environment=ENV_FILE=/var/www/ravelyth/.env
Environment=BACKUP_DIR=/var/backups/ravelyth
ExecStart=/usr/local/sbin/ravelyth-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ravelyth
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
