[Unit]
Description=Timer: Send Ravelyth Talent job alerts (daily 06:30)
Documentation=file:/var/www/ravelyth/DEPLOYMENT.md

[Timer]
OnCalendar=*-*-* 06:30:00
# Spread the first run slightly so timers do not all fire on the same second.
Persistent=true
AccuracySec=30s
RandomizedDelaySec=30
Unit=ravelyth-cron-send-job-alerts.service

[Install]
WantedBy=timers.target
