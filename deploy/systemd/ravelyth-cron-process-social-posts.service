[Unit]
Description=Publish queued Ravelyth Talent social posts
After=network.target ravelyth.service
Requires=ravelyth.service

[Service]
Type=oneshot
User=ravelyth
Group=ravelyth
WorkingDirectory=/var/www/ravelyth
EnvironmentFile=/var/www/ravelyth/.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 300 -H "x-cron-secret: ${CRON_SECRET}" http://127.0.0.1:3000/api/internal/cron/process-social-posts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ravelyth-cron-process-social-posts

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
